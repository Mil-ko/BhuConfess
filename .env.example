# ── Server ──────────────────────────────────────────────────────────
# Port for the Express health-check/stats server
PORT=3000
# development | production (controls log level and error messages)
NODE_ENV=development

# ── Telegram Bot (required) ─────────────────────────────────────────
# Token from @BotFather
BOT_TOKEN=your-telegram-bot-token
# Your numeric Telegram user ID (admin review, /pending, /stats, ...)
# Comma-separate multiple IDs: 123456789,987654321
ADMIN_ID=123456789

# ── Database (required) ─────────────────────────────────────────────
# MongoDB connection string (e.g. MongoDB Atlas)
MONGODB_URI=mongodb+srv://user:pass@cluster.mongodb.net/bhuconfession

# ── Channel posting (optional) ──────────────────────────────────────
# Default channel ID or @username; can also be set at runtime via /setchannel
# The bot must be an admin in this channel.
CHANNEL_ID=@your-channel

# ── HTTP API auth (optional, for protected Express endpoints) ───────
# Sent as the x-admin-key header
ADMIN_API_KEY=change-me-to-a-long-random-secret
